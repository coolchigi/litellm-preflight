# Round-robins across every replica of ${UPSTREAM_HOST}. nginx resolves the
# name once at startup, so it picks up all replicas that are up by then
# (compose starts lb only after they're healthy).
upstream litellm {
    server ${UPSTREAM_HOST}:4000;
    keepalive 32;
}

server {
    listen 80;
    client_max_body_size 50m;

    location / {
        proxy_pass http://litellm;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        # $http_host keeps the port, so redirects (/metrics -> /metrics/) point back here
        proxy_set_header Host $http_host;
        proxy_read_timeout 300s;
        proxy_buffering off;
    }
}
